# EcoPulse Environment Variables Template
# Copy this file to .env and fill in your real credentials

# Google Gemini API Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ecopulse?retryWrites=true&w=majority

# Security
JWT_SECRET=your_jwt_secret_hash_here

# Privacy-Friendly Demo User Configuration (Optional - defaults to demo@ecopulse.app / EcoDemo123!)
DEMO_USER_EMAIL=demo@ecopulse.app
DEMO_USER_PASSWORD=EcoDemo123!
DEMO_USER_NAME="Eco Demo User"

# SMTP Configuration (For Password Reset / Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Optional: Custom Frontend / Deployment Domain
# FRONTEND_URL=https://your-custom-domain.com
